# 默认按文本处理，入库统一为 LF，检出时按平台转换
* text=auto

# 源码与配置不使用 CRLF，保持跨端一致
*.kt text eol=lf
*.kts text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.pro text eol=lf
*.gradle text eol=lf

# 二进制，禁止行尾转换
*.so binary
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.dex binary
*.png binary
*.webp binary
*.ttf binary
*.zip binary
*.7z binary
*.iso binary
*.img binary